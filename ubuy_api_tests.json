{
  "info": {
    "name": "Ubuy API Test Suite",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Ubuy Homepage Health Check",
      "request": {
        "method": "GET",
        "url": "https://www.ubuy.co.in"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200', function() {",
              "  pm.response.to.have.status(200);",
              "});",
              "pm.test('Response time under 5s', function() {",
              "  pm.expect(pm.response.responseTime).to.be.below(5000);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Ubuy Laptops Category",
      "request": {
        "method": "GET",
        "url": "https://www.ubuy.co.in/category/laptops-21457"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200', function() {",
              "  pm.response.to.have.status(200);",
              "});",
              "pm.test('Content-Type is HTML', function() {",
              "  pm.expect(pm.response.headers.get('Content-Type')).to.include('text/html');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "GitHub API Health Check",
      "request": {
        "method": "GET",
        "url": "https://api.github.com"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200', function() {",
              "  pm.response.to.have.status(200);",
              "});",
              "pm.test('Response is JSON', function() {",
              "  pm.response.to.be.json;",
              "});"
            ]
          }
        }
      ]
    }
  ]
}